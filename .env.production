# Clinical Appointment Scheduling System - Environment Configuration
# Copy this file to .env and update the values for your environment

# ====== SERVER CONFIGURATION ======
NODE_ENV=production
PORT=5000
HOST=localhost

# ====== SECURITY ======
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ====== DATABASE CONFIGURATION ======
# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=clinical_appointment_system
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0
MYSQL_TIMEOUT=60000

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/clinical_appointment_system
MONGODB_OPTIONS=retryWrites=true&w=majority

# ====== REDIS CONFIGURATION ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=clinical:

# ====== EMAIL CONFIGURATION ======
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Clinical Appointment System <noreply@clinicalapp.com>

# ====== SMS CONFIGURATION ======
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ====== FILE UPLOAD CONFIGURATION ======
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx
UPLOAD_TEMP_PATH=./uploads/temp
UPLOAD_AVATAR_PATH=./uploads/avatars
UPLOAD_MEDICAL_PATH=./uploads/medical

# ====== LOGGING CONFIGURATION ======
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_DATE_PATTERN=YYYY-MM-DD

# ====== RATE LIMITING ======
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_REGISTRATION_MAX=3

# ====== CORS CONFIGURATION ======
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# ====== SESSION CONFIGURATION ======
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_MAX_AGE=86400000

# ====== NOTIFICATION SETTINGS ======
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_REMINDER_HOURS=24,2
NOTIFICATION_QUEUE_ENABLED=true

# ====== HEALTH MONITORING ======
HEALTH_CHECK_INTERVAL=300000
HEALTH_DB_TIMEOUT=5000
HEALTH_REDIS_TIMEOUT=3000
HEALTH_ALERT_EMAIL=admin@clinicalapp.com

# ====== API DOCUMENTATION ======
API_DOCS_ENABLED=true
API_DOCS_TITLE=Clinical Appointment System API
API_DOCS_VERSION=1.0.0
API_DOCS_DESCRIPTION=RESTful API for Clinical Appointment Scheduling System

# ====== EXTERNAL SERVICES ======
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ====== ENCRYPTION ======
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_ALGORITHM=aes-256-gcm

# ====== BACKUP CONFIGURATION ======
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# ====== ANALYTICS ======
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365

# ====== FEATURE FLAGS ======
FEATURE_AI_PREDICTIONS=false
FEATURE_VIDEO_CALLS=false
FEATURE_PAYMENT_INTEGRATION=false
FEATURE_INSURANCE_VERIFICATION=false

# ====== PAYMENT GATEWAY ======
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# ====== SOCIAL AUTH ======
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ====== CACHE SETTINGS ======
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600
CACHE_TTL_VERY_LONG=86400

# ====== SOCKET.IO CONFIGURATION ======
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# ====== TIMEZONE SETTINGS ======
DEFAULT_TIMEZONE=America/New_York
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
BUSINESS_DAYS=1,2,3,4,5

# ====== APPOINTMENT SETTINGS ======
DEFAULT_APPOINTMENT_DURATION=30
MIN_APPOINTMENT_DURATION=15
MAX_APPOINTMENT_DURATION=120
ADVANCE_BOOKING_DAYS=90
MIN_ADVANCE_BOOKING_HOURS=2
CANCELLATION_DEADLINE_HOURS=24

# ====== SECURITY HEADERS ======
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_FRAME_OPTIONS=DENY
SECURITY_XSS_PROTECTION=true
