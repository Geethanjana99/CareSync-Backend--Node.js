# Clinical Appointment Scheduling System - Test Environment Configuration

# ====== SERVER CONFIGURATION ======
NODE_ENV=test
PORT=5001
HOST=localhost

# ====== SECURITY ======
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=4

# ====== DATABASE CONFIGURATION ======
# MySQL Test Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=clinical_appointment_system_test
MYSQL_CONNECTION_LIMIT=5
MYSQL_QUEUE_LIMIT=0
MYSQL_TIMEOUT=10000

# MongoDB Test Database
MONGODB_URI=mongodb://localhost:27017/clinical_appointment_system_test

# ====== REDIS CONFIGURATION ======
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_KEY_PREFIX=clinical:test:

# ====== EMAIL CONFIGURATION (DISABLED FOR TESTING) ======
EMAIL_ENABLED=false
EMAIL_SERVICE=test
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=test@example.com
EMAIL_PASSWORD=testpassword
EMAIL_FROM=Clinical Test <test@example.com>

# ====== SMS CONFIGURATION (DISABLED FOR TESTING) ======
SMS_ENABLED=false
SMS_PROVIDER=test
TWILIO_ACCOUNT_SID=test_sid
TWILIO_AUTH_TOKEN=test_token
TWILIO_PHONE_NUMBER=+1234567890

# ====== FILE UPLOAD CONFIGURATION ======
UPLOAD_PATH=./test_uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf
UPLOAD_TEMP_PATH=./test_uploads/temp
UPLOAD_AVATAR_PATH=./test_uploads/avatars
UPLOAD_MEDICAL_PATH=./test_uploads/medical

# ====== LOGGING CONFIGURATION ======
LOG_LEVEL=error
LOG_FILE_PATH=./test_logs
LOG_MAX_SIZE=5m
LOG_MAX_FILES=2
LOG_DATE_PATTERN=YYYY-MM-DD

# ====== RATE LIMITING (RELAXED FOR TESTING) ======
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_UPLOAD_MAX=50
RATE_LIMIT_REGISTRATION_MAX=10

# ====== CORS CONFIGURATION ======
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ====== SESSION CONFIGURATION ======
SESSION_SECRET=test-session-secret
SESSION_MAX_AGE=3600000

# ====== NOTIFICATION SETTINGS (DISABLED FOR TESTING) ======
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_REMINDER_HOURS=24,2
NOTIFICATION_QUEUE_ENABLED=false

# ====== HEALTH MONITORING ======
HEALTH_CHECK_INTERVAL=30000
HEALTH_DB_TIMEOUT=2000
HEALTH_REDIS_TIMEOUT=1000
HEALTH_ALERT_EMAIL=test@example.com

# ====== API DOCUMENTATION ======
API_DOCS_ENABLED=false

# ====== EXTERNAL SERVICES (DISABLED FOR TESTING) ======
GOOGLE_CALENDAR_ENABLED=false

# ====== ENCRYPTION ======
ENCRYPTION_KEY=test-32-character-encryption-key1
ENCRYPTION_ALGORITHM=aes-256-gcm

# ====== BACKUP CONFIGURATION (DISABLED FOR TESTING) ======
BACKUP_ENABLED=false

# ====== ANALYTICS (DISABLED FOR TESTING) ======
ANALYTICS_ENABLED=false

# ====== FEATURE FLAGS (DISABLED FOR TESTING) ======
FEATURE_AI_PREDICTIONS=false
FEATURE_VIDEO_CALLS=false
FEATURE_PAYMENT_INTEGRATION=false
FEATURE_INSURANCE_VERIFICATION=false

# ====== CACHE SETTINGS ======
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_LONG=600
CACHE_TTL_VERY_LONG=1800

# ====== TIMEZONE SETTINGS ======
DEFAULT_TIMEZONE=UTC
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
BUSINESS_DAYS=1,2,3,4,5

# ====== APPOINTMENT SETTINGS ======
DEFAULT_APPOINTMENT_DURATION=30
MIN_APPOINTMENT_DURATION=15
MAX_APPOINTMENT_DURATION=120
ADVANCE_BOOKING_DAYS=30
MIN_ADVANCE_BOOKING_HOURS=1
CANCELLATION_DEADLINE_HOURS=2
