# Test Environment Configuration
NODE_ENV=test

# Database Configuration - Test
DB_HOST=localhost
DB_PORT=3306
DB_USER=test_user
DB_PASSWORD=test_password
DB_NAME=caresync_test
DB_CONNECTION_LIMIT=5

# MongoDB Configuration - Test
MONGODB_URI=mongodb://localhost:27017/caresync_test
MONGODB_TEST_DB=caresync_test

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_for_testing_only
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=test_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis Configuration - Test
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Email Configuration - Test (Mock)
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test_password
EMAIL_FROM=test@caresync.com
EMAIL_FROM_NAME=CareSync Test

# SMS Configuration - Test (Mock)
TWILIO_ACCOUNT_SID=test_account_sid
TWILIO_AUTH_TOKEN=test_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload Configuration - Test
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_DEST=uploads/test

# API Configuration - Test
API_VERSION=v1
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting - Test (More permissive)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_UPLOAD_MAX=50
RATE_LIMIT_ADMIN_MAX=500

# Security Configuration - Test
BCRYPT_ROUNDS=10
SESSION_SECRET=test_session_secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Logging Configuration - Test
LOG_LEVEL=error
LOG_FILE=logs/test.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Health Monitoring - Test
HEALTH_CHECK_INTERVAL=30000
MEMORY_THRESHOLD=80
CPU_THRESHOLD=80
DISK_THRESHOLD=85
RESPONSE_TIME_THRESHOLD=2000

# AI Service Configuration - Test (Mock)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=test_ai_key
AI_SERVICE_TIMEOUT=30000

# Notification Configuration - Test
NOTIFICATION_QUEUE_CONCURRENCY=2
EMAIL_QUEUE_DELAY=1000
SMS_QUEUE_DELAY=1000

# Client Configuration - Test
CLIENT_URL=http://localhost:3000
CLIENT_RESET_PASSWORD_URL=http://localhost:3000/reset-password
CLIENT_VERIFY_EMAIL_URL=http://localhost:3000/verify-email

# Testing Configuration
TEST_TIMEOUT=10000
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=adminpassword123
